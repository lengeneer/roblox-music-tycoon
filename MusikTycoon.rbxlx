	block(f, "Wand2", Vector3.new(0.4, 10, 14), o * base * CFrame.new(7, 6.4, 0), rgb(40, 40, 45), Enum.Material.Fabric)
	block(f, "Dach", Vector3.new(14.4, 0.6, 14.4), o * base * CFrame.new(0, 11.7, 0), DARK)
