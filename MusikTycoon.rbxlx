	block(f, "Tuersturz", Vector3.new(5, 3, 0.4), o * base * CFrame.new(0, 9.9, -7), rgb(170, 220, 255), Enum.Material.Glass, {Transparency = 0.5})
	block(f, "Glas2", Vector3.new(0.4, 10, 14), o * base * CFrame.new(-7, 6.4, 0), rgb(170, 220, 255), Enum.Material.Glass, {Transparency = 0.5})
