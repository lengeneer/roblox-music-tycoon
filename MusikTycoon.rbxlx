-- Palmen in den Lücken zwischen den Studios und am Rand
do
	local function palme(px, pz, h)
		block(MAP, "PalmStamm", Vector3.new(1.4, h, 1.4), CFrame.new(px, h / 2, pz), rgb(120, 85, 50), Enum.Material.Wood)
		for k = 0, 5 do
			block(MAP, "PalmBlatt", Vector3.new(5.5, 0.35, 2),
				CFrame.new(px, h + 0.3, pz) * CFrame.Angles(0, k * math.pi / 3, 0) * CFrame.new(2.6, 0, 0) * CFrame.Angles(0, 0, math.rad(-22)),
				rgb(50, 150, 70), Enum.Material.Grass, {CanCollide = false})
		end
		block(MAP, "PalmKrone", Vector3.new(2.4, 2.4, 2.4), CFrame.new(px, h + 0.4, pz), rgb(60, 130, 60), Enum.Material.Grass, {Shape = Enum.PartType.Ball})
	end
	for g = 0, PLOT_COUNT do
		local gx = (g - PLOT_COUNT / 2) * PLOT_SPACING
		for pz = -40, 100, 35 do
			palme(gx, pz, 13 + ((g + pz) % 3) * 2)
		end
	end
end

------------------------------------------------------------------
-- MUSIKER AUF DEM BOULEVARD (2 Reihen à 10)
------------------------------------------------------------------
local tryFeature
local tryRebirth
local MUSIKER_HEADS = {}

local perRow = math.ceil(#MUSIKER / 2)
for i, r in ipairs(MUSIKER) do
	local rowIdx = (i <= perRow) and 0 or 1
	local k = (i - 1) % perRow
	local spacing = math.min(80, (halfWidth * 2 - 80) / perRow)
	local x = -((perRow - 1) * spacing) / 2 + k * spacing
	local z = (rowIdx == 0) and -100 or -152
	local h = 1 + i * 1.3
	local folder = Instance.new("Model")
	folder.Name = "Musiker_" .. i .. "_" .. r.name
	folder:SetAttribute("MusikerIndex", i)
	folder.Parent = MAP

	local tier = Color3.fromHSV((i - 1) / #MUSIKER * 0.85, 0.8, 1)
	block(folder, "Podest", Vector3.new(12, h, 12), CFrame.new(x, h / 2, z), DARK, Enum.Material.Marble)
	local ring = block(folder, "PodestLicht", Vector3.new(12.4, 0.4, 12.4), CFrame.new(x, h - 0.1, z), tier, Enum.Material.Neon)
	light("SpotLight", ring, tier, 18, 3, {Face = Enum.NormalId.Top, Angle = 70})
	block(folder, "PodestSockel", Vector3.new(14, 0.6, 14), CFrame.new(x, 0.7, z), rgb(50, 45, 60), Enum.Material.Marble)
	local plaque = block(folder, "Tafel", Vector3.new(8, 2.5, 0.3), CFrame.new(x, math.max(1.8, math.min(h - 1.5, 3)), z + 6.1), tier, Enum.Material.Neon)
	sign(plaque, Enum.NormalId.Back, "#" .. i .. " " .. r.genre, BLACK)

	local figCF = CFrame.new(x, h, z) * CFrame.Angles(0, math.pi, 0)
	local head = buildFigure(folder, figCF, r, 2)
	MUSIKER_HEADS[i] = head

	local bb = Instance.new("BillboardGui")
	bb.Name = "Info"
	bb.Size = UDim2.fromOffset(260, 115)
	bb.StudsOffset = Vector3.new(0, 5, 0)
	bb.MaxDistance = 120
	bb.Adornee = head
	bb.Parent = head
	local nameL = Instance.new("TextLabel")
	nameL.Size = UDim2.fromScale(1, 0.36)
	nameL.BackgroundTransparency = 1
	nameL.TextScaled = true
	nameL.Font = Enum.Font.GothamBlack
	nameL.TextColor3 = tier
	nameL.TextStrokeTransparency = 0
	nameL.Text = "#" .. i .. "  " .. r.name .. "  (" .. r.genre .. ")"
	nameL.Parent = bb
	local infoL = Instance.new("TextLabel")
	infoL.Size = UDim2.fromScale(1, 0.4)
	infoL.Position = UDim2.fromScale(0, 0.36)
	infoL.BackgroundTransparency = 1
	infoL.TextScaled = true
	infoL.Font = Enum.Font.GothamBold
	infoL.TextColor3 = WHITE
	infoL.TextStrokeTransparency = 0
	infoL.Text = string.format("👥 %s Fans  •  💸 $%s\n+%d%% Einkommen", fmt(r.fans), fmt(r.cost), math.floor(r.mult * 100 + 0.5))
	infoL.Parent = bb
	-- wird vom Client pro Spieler gefüllt (✅ / 🎯 / 🔒)
	local statusL = Instance.new("TextLabel")
	statusL.Name = "Status"
	statusL.Size = UDim2.fromScale(1, 0.24)
	statusL.Position = UDim2.fromScale(0, 0.76)
	statusL.BackgroundTransparency = 1
	statusL.TextScaled = true
	statusL.Font = Enum.Font.GothamBlack
	statusL.TextColor3 = GOLD
	statusL.TextStrokeTransparency = 0
	statusL.Text = ""
	statusL.Parent = bb

	local micZ = z + 9
	block(folder, "MikroFuss", Vector3.new(2, 0.3, 2), CFrame.new(x, 0.55, micZ), DARK, Enum.Material.Metal)
	local stand = block(folder, "MikroStaender", Vector3.new(0.3, 4.5, 0.3), CFrame.new(x, 2.9, micZ), DARK, Enum.Material.Metal, {attrs = {MusikerIndex = i}})
	block(folder, "MikroKopf", Vector3.new(0.9, 0.9, 0.9), CFrame.new(x, 5.4, micZ), rgb(180, 180, 190), Enum.Material.Metal, {Shape = Enum.PartType.Ball})

	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "Feature machen"
	prompt.ObjectText = r.name
	prompt.HoldDuration = 0.8
	prompt.MaxActivationDistance = 10
	prompt.RequiresLineOfSight = false
	prompt.Parent = stand
	prompt.Triggered:Connect(function(player)
		tryFeature(player, i)
	end)
end

-- Album-Presswerk (Rebirth) neben dem Spawn
do
	local f = Instance.new("Model")
	f.Name = "AlbumPresswerk"
	f.Parent = MAP
	local house = block(f, "Presswerk", Vector3.new(14, 10, 10), CFrame.new(34, 5.4, -70), rgb(25, 25, 35), Enum.Material.Metal)
	block(f, "Dach", Vector3.new(15, 1, 11), CFrame.new(34, 10.9, -70), GOLD, Enum.Material.Neon, {attrs = {Pulse = 1.5}})
	block(f, "CD", Vector3.new(0.5, 8, 8), CFrame.new(34, 17, -70) * CFrame.Angles(0, math.rad(90), 0), rgb(220, 220, 255), Enum.Material.Foil, {Shape = Enum.PartType.Cylinder, attrs = {Spin = 1.2}})
	sign(house, Enum.NormalId.Back, "💿 NEUES ALBUM\n(nach der Legende)", GOLD)
	sign(house, Enum.NormalId.Front, "💿 NEUES ALBUM\n(nach der Legende)", GOLD)
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "Neues Album droppen"
	prompt.ObjectText = "Rebirth: +" .. math.floor(ALBUM_BONUS * 100) .. "% für immer"
	prompt.HoldDuration = 2
	prompt.MaxActivationDistance = 12
	prompt.RequiresLineOfSight = false
	prompt.Parent = house
	prompt.Triggered:Connect(function(player)
		tryRebirth(player)
	end)
end

