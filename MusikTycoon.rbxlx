Lighting.ClockTime = 18.7
Lighting.Brightness = 2.2
Lighting.Ambient = rgb(60, 50, 80)
Lighting.OutdoorAmbient = rgb(120, 105, 150)
Lighting.GeographicLatitude = 30

local function effect(class, name, props)
	local old = Lighting:FindFirstChild(name)
	if old then old:Destroy() end
	local e = Instance.new(class)
	e.Name = name
	for k, v in pairs(props) do
		e[k] = v
	end
	e.Parent = Lighting
	return e
end
effect("Atmosphere", "MT_Atmosphere", {Density = 0.32, Offset = 0.15, Color = rgb(205, 170, 230), Decay = rgb(90, 55, 140), Glare = 0.4, Haze = 1.6})
effect("BloomEffect", "MT_Bloom", {Intensity = 0.7, Size = 28, Threshold = 1.5})
effect("ColorCorrectionEffect", "MT_Color", {Brightness = 0.02, Contrast = 0.1, Saturation = 0.15, TintColor = rgb(255, 245, 255)})
effect("SunRaysEffect", "MT_SunRays", {Intensity = 0.06, Spread = 0.6})

