local function buildDropper(plot, item, folder)
	local o = plot.origin
	local x = DROPPER_X[(item.slot - 1) % 5 + 1]
	local lz = LINE_Z[(item.slot <= 5) and 1 or 2]
	local model = Instance.new("Model")
	model.Name = item.name
	model.Parent = folder
	block(model, "Pfosten", Vector3.new(1, 10, 1), o * CFrame.new(x, 6, lz + 6), DARK, Enum.Material.Metal)
	block(model, "Arm", Vector3.new(1, 1, 5), o * CFrame.new(x, 11, lz + 3.5), DARK, Enum.Material.Metal)
	local body = block(model, "Gehaeuse", Vector3.new(5, 4, 5), o * CFrame.new(x, 10, lz), item.color)
	block(model, "GehaeuseRing", Vector3.new(5.2, 0.4, 5.2), o * CFrame.new(x, 8.2, lz), item.color, Enum.Material.Neon, {attrs = {Pulse = 2}})
	block(model, "Duese", Vector3.new(2, 1, 2), o * CFrame.new(x, 7.5, lz), DARK, Enum.Material.Metal)
	sign(body, Enum.NormalId.Front, item.name, BLACK)
	billboard(body, "🎵 +$" .. fmt(item.value), UDim2.fromOffset(120, 34), 4, item.color)

	local spawnCF = o * CFrame.new(x, 6, lz)
	task.spawn(function()
		while model.Parent do
			task.wait(item.interval)
			if not model.Parent or not plot.owner then break end
			if #plot.drops:GetChildren() >= MAX_DROPS_PER_PLOT then continue end
			local drop = Instance.new("Part")
			drop.Name = "Track"
			drop.Shape = Enum.PartType.Ball
			drop.Size = Vector3.new(1.4, 1.4, 1.4)
			drop.CFrame = spawnCF
			drop.Color = item.color
			drop.Material = Enum.Material.Neon
			drop.CanQuery = false
			drop:SetAttribute("Value", item.value)
			drop.Parent = plot.drops
			pcall(function()
				drop:SetNetworkOwner(nil)
			end)
			Debris:AddItem(drop, 25)
		end
	end)
end

local function buildItem(plot, item)
	local f = Instance.new("Folder")
	f.Name = item.id
	f.Parent = plot.items
	if item.kind == "dropper" then
		buildDropper(plot, item, f)
	elseif DECOR[item.id] then
		DECOR[item.id](plot.origin, f)
	end
end

local function tryBuy(player, plot, item)
	local d = Data[player]
	if not d or d.owned[item.id] then return end
	if item.requires and not d.owned[item.requires] then return end
	if item.needFeatures and d.features < item.needFeatures then
		notifyOnce(player, item.id, "🔒 Mach erst ein Feature mit " .. MUSIKER[item.needFeatures].name .. "!", "bad")
		return
	end
	if d.cash < item.cost then
		notifyOnce(player, item.id, "💸 Zu wenig Geld für " .. item.name .. " ($" .. fmt(item.cost) .. ")", "bad")
		return
	end
	d.cash -= item.cost
	d.owned[item.id] = true
	buildItem(plot, item)
	refreshButtons(plot)
	updateStats(player)
	toast(player, "✅ " .. item.name .. " gekauft!", "good")
	if item.id == "villa" then
		toast(player, "🏟 Der hintere Konzertbereich ist offen! Lauf hinter die Villa.", "good")
	end
end

refreshButtons = function(plot)
	local d = plot.owner and Data[plot.owner]
	for _, item in ipairs(ITEMS) do
		local btn = plot.buttons[item.id]
		local visible = d ~= nil and not d.owned[item.id] and (item.requires == nil or d.owned[item.requires] == true)
		btn.part.Transparency = visible and 0 or 1
		btn.part.CanCollide = visible
		btn.part.CanTouch = visible
		btn.ring.Transparency = visible and 0 or 1
		btn.gui.Enabled = visible
		if visible then
			local locked = item.needFeatures and d.features < item.needFeatures
			local head = (KIND_ICON[item.kind] or "") .. " " .. item.name
			if locked then
				btn.part.Color = RED
				btn.label.TextColor3 = rgb(255, 170, 170)
				btn.label.Text = head .. "\n🔒 Feature mit " .. MUSIKER[item.needFeatures].name
			else
				btn.part.Color = GREEN
				btn.label.TextColor3 = WHITE
				btn.label.Text = head .. "\n$" .. fmt(item.cost) .. "  •  " .. itemInfo(item)
			end
		end
	end
end

local function setPlotSign(plot, text)
	for _, l in ipairs(plot.signLabels) do
		l.Text = text
	end
end

for i = 1, PLOT_COUNT do
	local x = (i - (PLOT_COUNT + 1) / 2) * PLOT_SPACING
	local o = CFrame.new(x, 0, 0)
	local accent = Color3.fromHSV(((i - 1) / PLOT_COUNT + 0.55) % 1, 0.75, 1)
	local folder = Instance.new("Model")
	folder.Name = "Studio_" .. i
	folder:SetAttribute("PlotIndex", i)
	folder.Parent = MAP

	local plot = {index = i, origin = o, owner = nil, buttons = {}, accent = accent}
	plot.spawnCF = o * CFrame.new(0, 4, -42)

	-- Boden: vorne z -50..50, hinten (Konzertbereich) z 50..110
	block(folder, "Boden", Vector3.new(100, 1, 100), o * CFrame.new(0, 0.5, 0), rgb(48, 46, 58), Enum.Material.Concrete)
	block(folder, "BodenHinten", Vector3.new(100, 1, 60), o * CFrame.new(0, 0.5, 80), rgb(40, 30, 58), Enum.Material.Concrete)
	block(folder, "Trennlinie", Vector3.new(100, 0.1, 1), o * CFrame.new(0, 1.05, 50), GOLD, Enum.Material.Neon)
	block(folder, "Eingangsteppich", Vector3.new(14, 0.1, 10), o * CFrame.new(0, 1.05, -45), rgb(170, 20, 50), Enum.Material.Fabric)

	-- Wände mit Neon-Kante (vorne mit Eingang)
	local walls = {
		{Vector3.new(1, 3, 160), Vector3.new(-49.5, 2.5, 30)},
		{Vector3.new(1, 3, 160), Vector3.new(49.5, 2.5, 30)},
		{Vector3.new(100, 3, 1), Vector3.new(0, 2.5, 109.5)},
		{Vector3.new(34, 3, 1), Vector3.new(-33, 2.5, -49.5)},
		{Vector3.new(34, 3, 1), Vector3.new(33, 2.5, -49.5)},
	}
	for _, w in ipairs(walls) do
		block(folder, "Wand", w[1], o * CFrame.new(w[2]), DARK, Enum.Material.Metal)
		block(folder, "WandNeon", Vector3.new(w[1].X + 0.2, 0.3, w[1].Z + 0.2), o * CFrame.new(w[2] + Vector3.new(0, 1.65, 0)), accent, Enum.Material.Neon)
	end

	-- Lautsprecher-Türme an den vorderen Ecken
	for _, cx in ipairs({-46, 46}) do
		block(folder, "Lautsprecher", Vector3.new(5, 12, 5), o * CFrame.new(cx, 7, -46), rgb(20, 20, 26), Enum.Material.Metal)
		for _, my in ipairs({4.5, 9.5}) do
			block(folder, "Membran", Vector3.new(0.4, 3.6, 3.6), o * CFrame.new(cx, my, -48.6) * CFrame.Angles(0, math.rad(90), 0), rgb(60, 60, 70), Enum.Material.Metal, {Shape = Enum.PartType.Cylinder})
		end
		local top = block(folder, "LautsprecherNeon", Vector3.new(5.4, 0.5, 5.4), o * CFrame.new(cx, 13.25, -46), accent, Enum.Material.Neon, {attrs = {Pulse = 2.5}})
		light("PointLight", top, accent, 20, 1.5)
	end

	-- Eingangstor mit Besitzerschild (beidseitig lesbar)
	for _, px in ipairs({-15.5, 15.5}) do
		block(folder, "TorSaeule", Vector3.new(2, 14, 2), o * CFrame.new(px, 8, -49.5), DARK, Enum.Material.Metal)
		block(folder, "TorNeon", Vector3.new(2.2, 14, 0.3), o * CFrame.new(px, 8, -50.6), accent, Enum.Material.Neon)
	end
	local signPart = block(folder, "Besitzerschild", Vector3.new(30, 5, 1), o * CFrame.new(0, 12.5, -49.5), DARK)
	plot.signLabels = {
		sign(signPart, Enum.NormalId.Front, "Freies Studio #" .. i, accent),
		sign(signPart, Enum.NormalId.Back, "Freies Studio #" .. i, accent),
	}
	block(folder, "SchildKante", Vector3.new(30.4, 0.4, 1.4), o * CFrame.new(0, 15.2, -49.5), accent, Enum.Material.Neon)

	plot.items = Instance.new("Folder")
	plot.items.Name = "Gekauft"
	plot.items.Parent = folder
	plot.drops = Instance.new("Folder")
	plot.drops.Name = "Tracks"
	plot.drops.Parent = folder
	plot.mega = Instance.new("Folder")
	plot.mega.Name = "MegaFeature"
	plot.mega.Parent = folder

	-- zwei Fließbänder mit Kasse
	for lineIdx, lz in ipairs(LINE_Z) do
		local conveyor = block(folder, "Fliessband" .. lineIdx, Vector3.new(58, 1, 6), o * CFrame.new(-1, 1.5, lz), rgb(30, 30, 30), Enum.Material.DiamondPlate)
		conveyor.AssemblyLinearVelocity = Vector3.new(CONVEYOR_SPEED, 0, 0)
		local railF = block(folder, "Gelaender", Vector3.new(58, 1.5, 0.5), o * CFrame.new(-1, 2.75, lz - 3.25), GOLD, Enum.Material.Metal)
		local railB = block(folder, "Gelaender", Vector3.new(58, 1.5, 0.5), o * CFrame.new(-1, 2.75, lz + 3.25), GOLD, Enum.Material.Metal)
		-- Laufrichtung (+X) anzeigen: Front-Seite liest man von -Z, dort zeigt "rechts" nach -X
		sign(railF, Enum.NormalId.Front, "◀ ◀ ◀ ◀ ◀ ◀ ◀ ◀ ◀ ◀ ◀ ◀", BLACK)
		sign(railB, Enum.NormalId.Back, "▶ ▶ ▶ ▶ ▶ ▶ ▶ ▶ ▶ ▶ ▶ ▶", BLACK)
		local collector = block(folder, "Kasse" .. lineIdx, Vector3.new(6, 3, 8), o * CFrame.new(31, 2.5, lz), GREEN, Enum.Material.Neon)
		block(folder, "KassenDach", Vector3.new(7, 0.6, 9), o * CFrame.new(31, 4.3, lz), DARK, Enum.Material.Metal)
		billboard(collector, "💰 KASSE", UDim2.fromOffset(140, 40), 3.5, GREEN)
		collector.Touched:Connect(function(hit)
			if hit.Parent ~= plot.drops then return end
			local v = hit:GetAttribute("Value")
			if not v then return end
			hit:SetAttribute("Value", nil)
			hit:Destroy()
			if plot.owner then
				addEarnings(plot.owner, v)
			end
		end)
	end

	for idx, item in ipairs(ITEMS) do
		local pos = BTN_POS[idx]
		local ring = block(folder, "ButtonRing_" .. item.id, Vector3.new(6.4, 0.2, 6.4), o * CFrame.new(pos - Vector3.new(0, 0.1, 0)), rgb(20, 20, 26), Enum.Material.Metal, {CanCollide = false, CanTouch = false})
		local part = block(folder, "Button_" .. item.id, Vector3.new(5, 0.3, 5), o * CFrame.new(pos), GREEN, Enum.Material.Neon)
		local gui, label = billboard(part, item.name, UDim2.fromOffset(210, 62), 3, WHITE)
		gui.MaxDistance = 50
		plot.buttons[item.id] = {part = part, ring = ring, gui = gui, label = label}
		part.Touched:Connect(function(hit)
			local player = Players:GetPlayerFromCharacter(hit.Parent)
			if player and plot.owner == player then
				tryBuy(player, plot, item)
			end
		end)
	end

	PLOTS[i] = plot
	refreshButtons(plot)
end

------------------------------------------------------------------
-- FEATURES
------------------------------------------------------------------
tryFeature = function(player, i)
	local d = Data[player]
	if not d then return end
	local r = MUSIKER[i]
	if d.features >= i then
		toast(player, "Du hast schon ein Feature mit " .. r.name .. " 🤝", "info")
		return
	end
	if d.features < i - 1 then
		toast(player, "🚫 " .. r.name .. " kennt dich nicht. Arbeite dich erst an " .. MUSIKER[d.features + 1].name .. " vorbei!", "bad")
		return
	end
	if d.fans < r.fans then
		toast(player, "👥 " .. r.name .. " will mindestens " .. fmt(r.fans) .. " Fans sehen (du hast " .. fmt(d.fans) .. ")", "bad")
		return
	end
	if d.cash < r.cost then
		toast(player, "💸 Studiozeit mit " .. r.name .. " kostet $" .. fmt(r.cost), "bad")
		return
	end

	d.cash -= r.cost
	d.features = i
	d.fans += r.reward
	updateStats(player)
	if d.plot then
		refreshButtons(d.plot)
	end

	remote:FireClient(player, "feature", {name = r.name, title = r.title, spruch = r.spruch, final = (i == #MUSIKER)})
	local head = MUSIKER_HEADS[i]
	if head then
		local sp = Instance.new("Sparkles")
		sp.SparkleColor = GOLD
		sp.Parent = head
		Debris:AddItem(sp, 4)
	end

	toastOthers(player, "🔥 " .. player.DisplayName .. " hat einen Feature mit " .. r.name .. " gedroppt!", "info")
	if i == #MUSIKER then
		toastAll("👑 " .. player.DisplayName .. " ist jetzt eine MUSIK-LEGENDE! 👑", "good")
		toast(player, "💿 Geh zum Album-Presswerk am Spawn und droppe dein nächstes Album!", "good")
	end
end

------------------------------------------------------------------
-- MEGA-FEATURE (alle 30 Minuten Spielzeit)
------------------------------------------------------------------
local claimMega

local function spawnMega(player, d)
	local plot = d.plot
	if not plot then return end
	plot.mega:ClearAllChildren()
	local guest = MEGA_GAESTE[(d.megaCount % #MEGA_GAESTE) + 1]
	local o = plot.origin
	local f = plot.mega

	block(f, "Buehne", Vector3.new(22, 1.5, 10), o * CFrame.new(0, 1.75, -8), rgb(20, 20, 25), Enum.Material.Metal)
	block(f, "BuehnenLicht", Vector3.new(22.4, 0.3, 10.4), o * CFrame.new(0, 2.4, -8), GOLD, Enum.Material.Neon, {attrs = {Pulse = 4}})
	for _, sx in ipairs({-10, 10}) do
		local tower = block(f, "Lichtturm", Vector3.new(1.2, 14, 1.2), o * CFrame.new(sx, 9, -4), DARK, Enum.Material.Metal)
		local sp = Instance.new("Sparkles")
		sp.SparkleColor = GOLD
		sp.Parent = tower
		local fire = Instance.new("Fire")
		fire.Size = 6
		fire.Heat = 12
		fire.Color = rgb(255, 120, 0)
		fire.SecondaryColor = GOLD
		fire.Parent = block(f, "Feuerschale", Vector3.new(2, 1, 2), o * CFrame.new(sx, 16.5, -4), DARK, Enum.Material.Metal)
		for k = 1, 3 do
			local hue = Color3.fromHSV((k * 0.3 + (sx > 0 and 0.15 or 0)) % 1, 1, 1)
			block(f, "Strahl", Vector3.new(0.6, 30, 0.6),
				o * CFrame.new(sx, 16, -4) * CFrame.Angles(math.rad(-20 + k * 10), 0, math.rad(sx > 0 and -25 or 25)) * CFrame.new(0, 15, 0),
				hue, Enum.Material.Neon, {Transparency = 0.5, CanCollide = false, CanTouch = false, CanQuery = false})
		end
	end

	local head = buildFigure(f, o * CFrame.new(0, 2.5, -8), guest, 2)
	local bb = Instance.new("BillboardGui")
	bb.Size = UDim2.fromOffset(300, 90)
	bb.StudsOffset = Vector3.new(0, 4.5, 0)
	bb.MaxDistance = 200
	bb.AlwaysOnTop = true
	bb.Adornee = head
	bb.Parent = head
	local l = Instance.new("TextLabel")
	l.Size = UDim2.fromScale(1, 1)
	l.BackgroundTransparency = 1
	l.TextScaled = true
	l.Font = Enum.Font.GothamBlack
	l.TextColor3 = GOLD
	l.TextStrokeTransparency = 0
	l.Text = "⭐ MEGA-FEATURE ⭐\n" .. guest.name .. " (" .. guest.genre .. ")"
	l.Parent = bb

	block(f, "MegaMikroFuss", Vector3.new(2, 0.3, 2), o * CFrame.new(0, 1.15, -16), GOLD, Enum.Material.Neon)
	local stand = block(f, "MegaMikro", Vector3.new(0.3, 4.5, 0.3), o * CFrame.new(0, 3.5, -16), GOLD, Enum.Material.Metal)
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "MEGA-FEATURE aufnehmen!"
	prompt.ObjectText = guest.name
	prompt.HoldDuration = 1.5
	prompt.MaxActivationDistance = 12
	prompt.RequiresLineOfSight = false
	prompt.Parent = stand
	prompt.Triggered:Connect(function(who)
		if not plot.owner then return end
		if who == plot.owner then
			claimMega(who, guest)
		else
			toast(who, "Das ist nicht dein Studio – der Superstar wartet auf " .. plot.owner.DisplayName .. "!", "bad")
		end
	end)

	remote:FireClient(player, "megaArrive", {name = guest.name, genre = guest.genre})
	toastOthers(player, "⭐ " .. guest.name .. " ist gerade im Studio von " .. player.DisplayName .. " gelandet!", "info")
end

claimMega = function(player, guest)
	local d = Data[player]
	if not d or not d.megaPending then return end
	d.megaPending = false
	d.megaCount += 1
	d.nextMega = d.playtime + MEGA_INTERVAL

	local cash = math.max(2500, math.floor(incomeRate(d) * 600))
	local fans = math.max(1500, math.floor(d.fans * 0.25))
	d.cash += cash
	d.fans += fans
	d.boostLeft = BOOST_DURATION
	updateStats(player)
	if d.plot then
		d.plot.mega:ClearAllChildren()
	end

	remote:FireClient(player, "mega", {
		name = guest.name, genre = guest.genre, spruch = guest.spruch,
		cash = cash, fans = fans, boostMin = math.floor(BOOST_DURATION / 60), boostMult = BOOST_MULT,
	})
	toastOthers(player, "💥 " .. player.DisplayName .. " hat ein MEGA-FEATURE mit " .. guest.name .. " gedroppt!", "good")
end

------------------------------------------------------------------
-- NEUES ALBUM (Rebirth)
------------------------------------------------------------------
tryRebirth = function(player)
	local d = Data[player]
	if not d then return end
	if d.features < #MUSIKER then
		toast(player, "💿 Erst wenn du mit " .. MUSIKER[#MUSIKER].name .. " gefeatured hast, kannst du ein neues Album droppen.", "bad")
		return
	end
	d.albums += 1
	d.cash = START_CASH
	d.fans = 0
	d.features = 0
	d.owned = {}
	if d.plot then
		d.plot.items:ClearAllChildren()
		d.plot.drops:ClearAllChildren()
		refreshButtons(d.plot)
		local char = player.Character
		if char then
			char:PivotTo(d.plot.spawnCF)
		end
	end
	updateStats(player)
	remote:FireClient(player, "album", {albums = d.albums, bonus = math.floor(ALBUM_BONUS * d.albums * 100)})
	toastOthers(player, "💿 " .. player.DisplayName .. " hat Album Nr. " .. d.albums .. " gedroppt!", "good")
end

------------------------------------------------------------------
-- SPIELER
------------------------------------------------------------------
local function assignPlot(player)
	local d = Data[player]
	if not d then return nil end
	for _, plot in ipairs(PLOTS) do
		if not plot.owner then
			plot.owner = player
			d.plot = plot
			setPlotSign(plot, "🎤 " .. player.DisplayName .. "s Studio")
			for _, item in ipairs(ITEMS) do
				if d.owned[item.id] then
					buildItem(plot, item)
				end
			end
			refreshButtons(plot)
			updateStats(player)
			return plot
		end
	end
	return nil
end

local function removeFromQueue(player)
	for idx = #waiting, 1, -1 do
		if waiting[idx] == player then
			table.remove(waiting, idx)
		end
	end
end

local function releasePlot(plot)
	plot.owner = nil
	plot.items:ClearAllChildren()
	plot.drops:ClearAllChildren()
	plot.mega:ClearAllChildren()
	setPlotSign(plot, "Freies Studio #" .. plot.index)
	refreshButtons(plot)

	-- BUGFIX: wartende Spieler bekommen jetzt das frei gewordene Studio
	while #waiting > 0 do
		local nextPlayer = table.remove(waiting, 1)
		if nextPlayer.Parent and Data[nextPlayer] then
			local p = assignPlot(nextPlayer)
			if p then
				local char = nextPlayer.Character
				if char then
					char:PivotTo(p.spawnCF)
				end
				toast(nextPlayer, "🎉 Ein Studio ist frei geworden – es gehört jetzt dir!", "good")
			end
			break
		end
	end
end

-- Speichern: UpdateAsync mit Wiederholung, kein paralleles Doppelspeichern
local pendingSaves = 0

local function savePlayer(player, d)
	d = d or Data[player]
	if not d or not store or not d.loadOk then return end
	while d.saving do
		task.wait(0.1)
	end
	d.saving = true
	local owned = {}
	for id in pairs(d.owned) do
		table.insert(owned, id)
	end
	local payload = {
		cash = d.cash, fans = d.fans, features = d.features, owned = owned, albums = d.albums,
		playtime = d.playtime, nextMega = d.nextMega, megaCount = d.megaCount, boostLeft = d.boostLeft,
	}
	for attempt = 1, 3 do
		local ok, err = pcall(function()
			store:UpdateAsync("p_" .. player.UserId, function()
				return payload
			end)
		end)
		if ok then break end
		warn("[MusikTycoon] Speichern fehlgeschlagen (Versuch " .. attempt .. "): " .. tostring(err))
		if attempt < 3 then task.wait(attempt * 1.5) end
	end
	d.saving = false
end

-- Letztes Speichern beim Verlassen / Server-Ende: nur EINMAL pro Spieler
local function finalSave(player)
	local d = Data[player]
	if not d or d.finalSaved then return end
	d.finalSaved = true
	pendingSaves += 1
	savePlayer(player, d)
	pendingSaves -= 1
end

local function onPlayerAdded(player)
	local ls = Instance.new("Folder")
	ls.Name = "leaderstats"
	local function stat(class, name)
		local v = Instance.new(class)
		v.Name = name
		v.Parent = ls
	end
	stat("IntValue", "Geld")
	stat("IntValue", "Fans")
	stat("StringValue", "Rang")
	stat("IntValue", "Alben")
	ls.Parent = player

	local d = {
		cash = START_CASH, fans = 0, features = 0, owned = {}, albums = 0, lastMsg = {}, loadOk = false,
		playtime = 0, nextMega = MEGA_INTERVAL, megaCount = 0, boostLeft = 0, megaPending = false,
	}
	if store then
		local ok, saved
		local tries = RunService:IsStudio() and 1 or 3
		for attempt = 1, tries do
			ok, saved = pcall(function()
				return store:GetAsync("p_" .. player.UserId)
			end)
			if ok or not player.Parent then break end
			task.wait(attempt)
		end
		if ok then
			d.loadOk = true
			if type(saved) == "table" then
				d.cash = math.max(0, num(saved.cash, START_CASH))
				d.fans = math.max(0, num(saved.fans, 0))
				d.features = math.clamp(math.floor(num(saved.features, 0)), 0, #MUSIKER)
				d.albums = math.max(0, math.floor(num(saved.albums, 0)))
				d.playtime = math.max(0, num(saved.playtime, 0))
				d.nextMega = num(saved.nextMega, d.playtime + MEGA_INTERVAL)
				d.megaCount = math.max(0, math.floor(num(saved.megaCount, 0)))
				d.boostLeft = math.clamp(math.floor(num(saved.boostLeft, 0)), 0, BOOST_DURATION)
				if type(saved.owned) == "table" then
					for _, id in ipairs(saved.owned) do
						if ITEM_BY_ID[id] then
							d.owned[id] = true
						end
					end
				end
			end
		else
			warn("[MusikTycoon] Laden fehlgeschlagen (in Studio API-Zugriff aktivieren?): " .. tostring(saved))
		end
	end
	if not player.Parent then return end
	Data[player] = d

	local plot = assignPlot(player)
	if not plot then
		table.insert(waiting, player)
	end
	updateStats(player)

	local function toPlot(char)
		local hrp = char:WaitForChild("HumanoidRootPart", 5)
		if hrp and d.plot then
			task.wait(0.1)
			if d.plot and char.Parent then
				char:PivotTo(d.plot.spawnCF)
			end
		end
	end
	player.CharacterAdded:Connect(toPlot)
	if player.Character then
		task.spawn(toPlot, player.Character)
	end

	task.delay(2, function()
		if not player.Parent then return end
		if plot then
			toast(player, "🎤 Willkommen in deinem Studio! Kauf Laptop-Beats, hol dir Features auf dem Boulevard – alle 30 Min kommt ein MEGA-FEATURE ⭐", "good")
		else
			toast(player, "Alle Studios sind belegt 😕 – du bist in der Warteschlange und bekommst das nächste freie Studio.", "bad")
		end
		if store and not d.loadOk then
			toast(player, "⚠ Spielstand konnte nicht geladen werden – Fortschritt wird in dieser Sitzung NICHT gespeichert.", "bad")
		end
	end)
end

Players.PlayerAdded:Connect(onPlayerAdded)
for _, p in ipairs(Players:GetPlayers()) do
	task.spawn(onPlayerAdded, p)
end

Players.PlayerRemoving:Connect(function(player)
	removeFromQueue(player)
	local d = Data[player]
	-- erst das Studio freigeben (stoppt Dropper/Einkommen), dann speichern
	if d and d.plot then
		local plot = d.plot
		d.plot = nil
		releasePlot(plot)
	end
	finalSave(player)
	Data[player] = nil
end)

game:BindToClose(function()
	for p in pairs(Data) do
		task.spawn(finalSave, p)
	end
	local t0 = os.clock()
	while pendingSaves > 0 and os.clock() - t0 < 25 do
		task.wait(0.1)
	end
end)

-- Jede Sekunde: Spielzeit, Mega-Feature-Timer, Boost, passives Einkommen
task.spawn(function()
	while true do
		task.wait(1)
		for player, d in pairs(Data) do
			if d.plot then
				d.playtime += 1
				if d.boostLeft > 0 then
					d.boostLeft -= 1
					if d.boostLeft == 0 then
						toast(player, "Der Mega-Boost ist vorbei. Das nächste Mega-Feature kommt bestimmt! ⏱", "info")
						updateStats(player)
					end
				end
				if not d.megaPending and d.playtime >= d.nextMega then
					d.megaPending = true
					spawnMega(player, d)
				end
				player:SetAttribute("MegaIn", d.megaPending and 0 or math.max(0, d.nextMega - d.playtime))
				player:SetAttribute("MegaPending", d.megaPending)
				player:SetAttribute("BoostLeft", d.boostLeft)

				local income = passiveIncome(d)
				if income > 0 then
					local m = getMult(d)
					d.cash += income * m
					d.fans += math.ceil(income * 0.1 * m)
					updateStats(player)
				end
			end
		end
	end
end)

-- Autosave alle 60 Sekunden (gestaffelt, damit das DataStore-Limit nicht platzt)
task.spawn(function()
	while true do
		task.wait(60)
		for _, p in ipairs(Players:GetPlayers()) do
			local d = Data[p]
			if d and not d.finalSaved and not d.saving then
				task.spawn(savePlayer, p, d)
				task.wait(1)
			end
		end
	end
end)

print("[MusikTycoon] Map gebaut – viel Spaß auf dem Weg zur Legende! 🎤")
]]></ProtectedString></Properties></Item>
